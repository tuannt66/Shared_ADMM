<?xml version="1.0"?>
<!--
  Clearpath Jackal UGV — flattened URDF for PyBullet
  Derived from jackal_description/urdf/jackal.urdf.xacro (noetic-devel)
  Properties expanded manually:
    wheelbase=0.262  track=0.37559  wheel_radius=0.098  wheel_width=0.040
    chassis_length=0.420  chassis_width=0.310  chassis_height=0.184
    chassis_mass=16.523 kg   wheel_mass=0.477 kg (x4)
  Gazebo, transmission, and accessory blocks removed (not needed for PyBullet).
-->
<robot name="jackal">

  <material name="dark_grey"><color rgba="0.2 0.2 0.2 1.0"/></material>
  <material name="light_grey"><color rgba="0.4 0.4 0.4 1.0"/></material>
  <material name="yellow"><color rgba="0.8 0.8 0.0 1.0"/></material>
  <material name="black"><color rgba="0.15 0.15 0.15 1.0"/></material>

  <!-- ───────── base_link (empty root) ───────── -->
  <link name="base_link"/>

  <joint name="base_link_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="chassis_link"/>
  </joint>

  <!-- ───────── chassis ───────── -->
  <link name="chassis_link">
    <visual>
      <origin xyz="0 0 -0.0655" rpy="1.5707963 0 1.5707963"/>
      <geometry>
        <mesh filename="meshes/jackal-base.stl"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.092"/>
      <geometry>
        <box size="0.420 0.310 0.184"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.012 0.002 0.067" rpy="0 0 0"/>
      <mass value="16.523"/>
      <inertia ixx="0.3136" ixy="-0.0008" ixz="0.0164"
               iyy="0.3922" iyz="-0.0009"
               izz="0.4485"/>
    </inertial>
  </link>

  <!-- ───────── front fender (visual only) ───────── -->
  <link name="front_fender_link">
    <visual>
      <geometry>
        <mesh filename="meshes/jackal-fender.stl"/>
      </geometry>
      <material name="yellow"/>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
  </link>
  <joint name="front_fender_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="chassis_link"/>
    <child  link="front_fender_link"/>
  </joint>

  <!-- ───────── rear fender (visual only) ───────── -->
  <link name="rear_fender_link">
    <visual>
      <geometry>
        <mesh filename="meshes/jackal-fender.stl"/>
      </geometry>
      <material name="yellow"/>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
  </link>
  <joint name="rear_fender_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 3.14159265"/>
    <parent link="chassis_link"/>
    <child  link="rear_fender_link"/>
  </joint>

  <!-- ───────── IMU (zero-mass sensor frame) ───────── -->
  <link name="imu_link">
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="chassis_link"/>
    <child  link="imu_link"/>
  </joint>

  <!-- ───────── mount frames ───────── -->
  <link name="mid_mount">
    <inertial><mass value="0.001"/><origin xyz="0 0 0"/><inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/></inertial>
  </link>
  <joint name="mid_mount_joint" type="fixed">
    <parent link="chassis_link"/>
    <child  link="mid_mount"/>
    <origin xyz="0 0 0.184"/>
  </joint>

  <link name="rear_mount">
    <inertial><mass value="0.001"/><origin xyz="0 0 0"/><inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/></inertial>
  </link>
  <joint name="rear_mount_joint" type="fixed">
    <parent link="mid_mount"/>
    <child  link="rear_mount"/>
    <origin xyz="-0.120 0 0"/>
  </joint>

  <link name="front_mount">
    <inertial><mass value="0.001"/><origin xyz="0 0 0"/><inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/></inertial>
  </link>
  <joint name="front_mount_joint" type="fixed">
    <parent link="mid_mount"/>
    <child  link="front_mount"/>
    <origin xyz="0.120 0 0"/>
  </joint>

  <!-- ───────── WHEELS ───────── -->
  <!-- front_left -->
  <link name="front_left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <mesh filename="meshes/jackal-wheel.stl"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.098" length="0.040"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.477"/>
      <inertia ixx="0.0013" ixy="0" ixz="0"
               iyy="0.0024" iyz="0"
               izz="0.0013"/>
    </inertial>
  </link>
  <joint name="front_left_wheel" type="continuous">
    <parent link="chassis_link"/>
    <child  link="front_left_wheel_link"/>
    <origin xyz="0.131 0.18780 0.0345" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- front_right -->
  <link name="front_right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <mesh filename="meshes/jackal-wheel.stl"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.098" length="0.040"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.477"/>
      <inertia ixx="0.0013" ixy="0" ixz="0"
               iyy="0.0024" iyz="0"
               izz="0.0013"/>
    </inertial>
  </link>
  <joint name="front_right_wheel" type="continuous">
    <parent link="chassis_link"/>
    <child  link="front_right_wheel_link"/>
    <origin xyz="0.131 -0.18780 0.0345" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- rear_left -->
  <link name="rear_left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <mesh filename="meshes/jackal-wheel.stl"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.098" length="0.040"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.477"/>
      <inertia ixx="0.0013" ixy="0" ixz="0"
               iyy="0.0024" iyz="0"
               izz="0.0013"/>
    </inertial>
  </link>
  <joint name="rear_left_wheel" type="continuous">
    <parent link="chassis_link"/>
    <child  link="rear_left_wheel_link"/>
    <origin xyz="-0.131 0.18780 0.0345" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- rear_right -->
  <link name="rear_right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <mesh filename="meshes/jackal-wheel.stl"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.098" length="0.040"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.477"/>
      <inertia ixx="0.0013" ixy="0" ixz="0"
               iyy="0.0024" iyz="0"
               izz="0.0013"/>
    </inertial>
  </link>
  <joint name="rear_right_wheel" type="continuous">
    <parent link="chassis_link"/>
    <child  link="rear_right_wheel_link"/>
    <origin xyz="-0.131 -0.18780 0.0345" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

</robot>
